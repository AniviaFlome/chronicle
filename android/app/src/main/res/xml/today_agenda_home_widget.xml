<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-maintained appwidget-provider (no codegen). Keep the preview* and
     minResize* attributes in sync with the other widget XMLs (all 40dp:
     narrow layouts degrade gracefully, and hosts must not refuse a
     1-column shrink while other widgets allow it). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:description="@string/home_widget_today_agenda_description"

    android:previewLayout="@layout/widget_preview_today_agenda"
    android:previewImage="@drawable/widget_preview_today_agenda_img"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
/>
