<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for the Next class hero widget (WD-1).
     Hand-written RemoteViews-safe markup (no bare <View>): hairlines are
     tinted ImageViews. Mirrors the 2x2 narrow layout of SharedClassTab /
     ClassHero in WidgetComponents.kt + Samples.nextClass / Samples.looks
     so the 2x2 picker thumbnail never clips the time range or class name.
     Palette = theme-0 light (FEF7FF / 1C1B1F / 4F6BED). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FEF7FF">

    <!-- Elevated Hero Card (cardHigh) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/preview_shape_card"
        android:backgroundTint="#EAE3EE"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/preview_shape_pill"
            android:backgroundTint="#D8D8FB"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="in 12 min"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#24368F"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mathematics"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="08:40–09:30 · Room B4"
            android:textSize="11sp"
            android:textColor="#49454F"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Dr. Smith"
            android:textSize="10sp"
            android:textColor="#49454F"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Hairline divider (ImageView, RemoteViews-safe) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="#EAE3EE"
        android:contentDescription="@null" />

    <!-- Upcoming Lookahead Row (stacked narrow layout: full width for class name) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/preview_shape_card"
        android:backgroundTint="#F4EEF7"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Physics"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="10:20 · Room C3"
            android:textSize="10sp"
            android:textColor="#49454F"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
