<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for the Cafeteria menu widget.
     Hand-written RemoteViews-safe markup (no bare <View>): accent bars and
     hairline use tinted ImageViews. Mirrors MenuFeed in
     CafeteriaMenuHomeWidget.kt. Palette = theme-0 light. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FEF7FF">

    <!-- Elevated Meal Header Card (cardHigh) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/preview_shape_card"
        android:backgroundTint="#EAE3EE"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/preview_shape_pill"
                android:backgroundTint="#D8D8FB"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Lunch"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#24368F"
                android:maxLines="1" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="ITU"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#49454F"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="11:30–14:00"
            android:textSize="10sp"
            android:textColor="#49454F"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Hairline divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#EAE3EE"
        android:contentDescription="@null" />

    <!-- Tonal Dish Card 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/preview_shape_chip"
        android:backgroundTint="#F4EEF7"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@drawable/preview_shape_pill"
            android:backgroundTint="#4F6BED"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Lentil soup"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Tonal Dish Card 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/preview_shape_chip"
        android:backgroundTint="#F4EEF7"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@drawable/preview_shape_pill"
            android:backgroundTint="#4F6BED"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Grilled chicken"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Tonal Dish Card 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/preview_shape_chip"
        android:backgroundTint="#F4EEF7"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@drawable/preview_shape_pill"
            android:backgroundTint="#4F6BED"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Rice pilaf"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
