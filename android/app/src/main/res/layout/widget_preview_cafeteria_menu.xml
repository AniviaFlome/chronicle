<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for the Cafeteria menu widget.
     Hand-written RemoteViews-safe markup (no bare <View>): dots are
     tinted ImageViews over preview_shape_* bases. Mirrors TallColumn in
     CafeteriaMenuHomeWidget.kt. Palette = theme-0 light. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FEF7FF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lunch · ITU"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#49454F"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/preview_shape_dot"
            android:backgroundTint="#4F6BED"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Lentil soup"
            android:textSize="14sp"
            android:textColor="#1C1B1F" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/preview_shape_dot"
            android:backgroundTint="#4F6BED"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Grilled chicken"
            android:textSize="14sp"
            android:textColor="#1C1B1F" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/preview_shape_dot"
            android:backgroundTint="#4F6BED"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Rice pilaf"
            android:textSize="14sp"
            android:textColor="#1C1B1F" />
    </LinearLayout>
</LinearLayout>
