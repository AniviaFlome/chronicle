<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for the Weekly classes widget.
     Hand-written RemoteViews-safe markup (no bare <View>): stripes are
     tinted ImageViews over preview_shape_* bases. Mirrors TallColumn in
     WeeklyCalendarHomeWidget.kt. Palette = theme-0 light. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FEF7FF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mon 8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#49454F"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/preview_shape_chip"
        android:backgroundTint="#ECE6F0"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mathematics"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="08:40"
            android:textSize="13sp"
            android:textColor="#49454F" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tue 9"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#49454F"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/preview_shape_chip"
        android:backgroundTint="#ECE6F0"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Physics"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="10:20"
            android:textSize="13sp"
            android:textColor="#49454F" />
    </LinearLayout>
</LinearLayout>
