<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for the Today's agenda widget, current design
     (hand-written: re-add android:previewLayout to
     today_agenda_home_widget.xml after any CLI regen. NOTE: no bare
     <View> elements — RemoteViews forbids them; the divider is an
     ImageView. Rail = weekday names only, selected day accent-bold;
     rows = accent time + white name, no rooms. Matches the live widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1C1B1F">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tue"
            android:textSize="14sp"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#D0BCFF" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wed"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#CAC4D0" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thu"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#CAC4D0" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fri"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#CAC4D0" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sat"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#CAC4D0" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sun"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#CAC4D0" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mon"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#CAC4D0" />
    </LinearLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#2A2D37" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="08:40"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#D0BCFF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:text="Mathematics"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="10:20"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#D0BCFF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:text="Physics"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="13:00"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#D0BCFF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:text="Chemistry lab"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
