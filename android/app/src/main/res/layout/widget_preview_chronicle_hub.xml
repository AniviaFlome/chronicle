<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for the Chronicle hub widget (WD-1).
      Hand-written RemoteViews-safe markup (no bare <View>): arrows are
      tinted ImageViews, hairline an ImageView. Mirrors HubContent in
      ChronicleHubHomeWidget.kt (class tab, bottom TabBar) +
      Samples.nextClass/Samples.looks. Palette = theme-0 light.
      Event rows are neutral tonal blocks (no per-class colors). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FEF7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_school"
            android:tint="#4F6BED"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Next class"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/preview_shape_stripe"
        android:backgroundTint="#ECE6F0"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/preview_shape_pill"
            android:backgroundTint="#D8D8FB"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="in 12 min"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#24368F" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mathematics"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/preview_shape_chip"
            android:backgroundTint="#ECE6F0"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="08:40–09:30 · Room B4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/preview_shape_chip"
            android:backgroundTint="#ECE6F0"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Then Physics"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1C1B1F"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="10:20"
                android:textSize="13sp"
                android:textColor="#49454F" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/preview_shape_chip"
            android:backgroundTint="#ECE6F0"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Later Chemistry lab"
                android:textSize="15sp"
                android:textColor="#1C1B1F"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="13:00"
                android:textSize="13sp"
                android:textColor="#49454F" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_chevron_left"
            android:tint="#49454F"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="6dp"
                android:background="@drawable/preview_shape_pill"
                android:backgroundTint="#4F6BED"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/preview_shape_dot"
                android:backgroundTint="#CAC4D0"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/preview_shape_dot"
                android:backgroundTint="#CAC4D0"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/preview_shape_dot"
                android:backgroundTint="#CAC4D0"
                android:contentDescription="@null" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_chevron_right"
            android:tint="#49454F"
            android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
