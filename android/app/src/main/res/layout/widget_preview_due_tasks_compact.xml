<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for the Due tasks checklist widget (WD-1).
     Hand-written RemoteViews-safe markup (no bare <View>): checkboxes are
     ring ImageViews, the hairline an ImageView. Mirrors TasksContent in
     DueTasksCompactHomeWidget.kt + Samples.tasks (urgent row bold with an
     error chip). Palette = theme-0 light (FEF7FF / 1C1B1F / 4F6BED). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FEF7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_task"
            android:tint="#4F6BED"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Due tasks"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/preview_shape_pill"
            android:backgroundTint="#D8D8FB"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="3"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#24368F" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/preview_shape_stripe"
        android:backgroundTint="#ECE6F0"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/preview_shape_ring"
            android:backgroundTint="#79747E"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Submit lab report"
            android:textSize="15sp"
            android:textColor="#1C1B1F"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/preview_shape_chip"
            android:backgroundTint="#ECE6F0"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="tomorrow"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#49454F" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/preview_shape_ring"
            android:backgroundTint="#79747E"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Read chapter 4"
            android:textSize="15sp"
            android:textColor="#1C1B1F"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/preview_shape_chip"
            android:backgroundTint="#ECE6F0"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Fri"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#49454F" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/preview_shape_ring"
            android:backgroundTint="#79747E"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Problem set 5"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/preview_shape_chip"
            android:backgroundTint="#F9DEDC"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="yesterday"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#601410" />
    </LinearLayout>
</LinearLayout>
