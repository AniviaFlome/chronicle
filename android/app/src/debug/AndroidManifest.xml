<!-- Debug-only manifest overlay: distinct launcher/widget-picker label so
     the side-by-side debug app (applicationIdSuffix ".debug") is
     distinguishable from the release app. Merged into debug builds only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:label="Chronicle Dev"
        tools:replace="android:label">
    </application>
</manifest>
